# 复制为 config/local.env 后填写真实值（该文件已被 .gitignore 忽略，不会提交）
LOADPROBE_DB_URL=jdbc:postgresql://127.0.0.1:5432/load_probe
LOADPROBE_DB_USER=load_probe
LOADPROBE_DB_PASSWORD=change-me
# 查询接口密钥：调用时放在请求头 X-API-Key
LOADPROBE_API_KEY=change-me
# 采集间隔（秒），最小 10
LOADPROBE_INTERVAL_SECONDS=60
# 每轮保留的 Top 进程数
LOADPROBE_TOP_N=10
# 数据保留天数
LOADPROBE_RETENTION_DAYS=7
# 日志文件位置（留空则用 <项目>/logs/load-probe.log）
LOADPROBE_LOG_FILE=
